# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real credentials must never be committed.

# Neon PostgreSQL connection string (server-only, never exposed to the browser).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Cookie security behind Render's TLS proxy. Set to "true" in production.
TRUST_PROXY=true

# Initial admin provisioning (used ONLY by `npm run create-admin`).
# Prefer the interactive hidden prompt; if you set the password here,
# DELETE it from your environment after provisioning.
ADMIN_EMAIL=kunalfarma189@gmail.com
ADMIN_INITIAL_PASSWORD=

# Optional: admin session idle-expiry in hours (1-24, default 8).
SESSION_TTL_HOURS=8

# TEST-ONLY database for integration tests. Never point this at production.
# tests/auth.integration.test.ts refuses to run against DATABASE_URL.
TEST_DATABASE_URL=
